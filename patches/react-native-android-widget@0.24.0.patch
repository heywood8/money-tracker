+package com.reactnativeandroidwidget.builder;
+
+import android.widget.TextView;
+
+import androidx.annotation.Nullable;
+
+/**
+ * Penny patch: a TextWidget given `rollingGroup`, whose text is shown in live
+ * slots over the bitmap so its digits can roll (RollingText).
+ */
+public class RollingTextView {
+    private final int group;
+    @Nullable
+    private final String key;
+    private final TextView view;
+
+    RollingTextView(int group, @Nullable String key, TextView view) {
+        this.group = group;
+        this.key = key;
+        this.view = view;
+    }
+
+    public int getGroup() {
+        return group;
+    }
+
+    /** What the text is of (a rate's pair and amount): another key is another figure, not a move. */
+    @Nullable
+    public String getKey() {
+        return key;
+    }
+
+    public TextView getView() {
+        return view;
+    }
+}
