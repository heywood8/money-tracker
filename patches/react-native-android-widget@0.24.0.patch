@@ -0,0 +1,672 @@
+package com.reactnativeandroidwidget;
+
+import android.appwidget.AppWidgetManager;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.graphics.Color;
+import android.graphics.Rect;
+import android.graphics.Typeface;
+import android.os.Build;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.PowerManager;
+import android.text.Layout;
+import android.util.Log;
+import android.util.TypedValue;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.ViewParent;
+import android.widget.RemoteViews;
+import android.widget.TextView;
+
+import androidx.annotation.Nullable;
+import androidx.annotation.RequiresApi;
+
+import com.reactnativeandroidwidget.builder.RollingTextView;
+import com.reactnativeandroidwidget.builder.WidgetWithViews;
+
+import java.math.BigInteger;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+/**
+ * Penny patch: rolling digits on a home-screen widget.
+ *
+ * The library draws a widget as one bitmap, and a bitmap cannot move. A
+ * TextWidget given `rollingGroup` (0 or 1) is therefore left out of the bitmap
+ * (drawn transparent, so the layout around it is unchanged) and shown instead
+ * in live views laid over it, res/layout/rn_widget_rolling.xml: one
+ * ViewFlipper per character, placed at that character's own x and with its
+ * baseline on the drawn text's, holding two TextViews. Only a widget that
+ * rolls is sent the layout holding them (rn_widget_rolling_host.xml). When the text changes to one of the same shape (digits where
+ * digits were, every other character the same), the widget is sent a frame per
+ * step, 4,459 → 4,460 → … → 4,465, and in each the slots whose digit changes
+ * flip to their hidden TextView, which the launcher animates: on a rise the old
+ * digit rolls down and the new one comes in from above, on a fall the reverse.
+ *
+ * Every frame is a full update built on the library's own (the bitmaps, the
+ * tap areas), so no partial update replays an old flip, and it sets every
+ * slot's text, so a launcher that drops frames, or inflates the views afresh,
+ * still shows the right figure. A frame flips only the slots changing in it:
+ * a flipper animates whenever it is told which child to show, even the one it
+ * shows, so the settled frame sent after the last roll names none.
+ *
+ * With the screen off nobody sees a roll, and a process killed before its
+ * steps ran would leave the old figure up: the new one is shown at once.
+ *
+ * Android 12 (API 31) and up: the slots are placed with setViewLayoutMargin and
+ * coloured per night mode with setColorInt. Older versions keep the text in
+ * the bitmap.
+ */
+final class RollingText {
+    private static final String TAG = "RollingText";
+    private static final String PREFS = "rn_widget_rolling";
+    /** At most this many steps: a bigger move skips values, as a counter read at speed. */
+    private static final int MAX_STEPS = 8;
+    /** Before the first roll, so the refreshed frame is on screen first. */
+    private static final long FIRST_STEP_DELAY_MS = 250;
+    /** Between rolls: longer than one roll (res/anim, 140 ms), so each ends before the next. */
+    private static final long STEP_INTERVAL_MS = 160;
+    /** Added to each of the last few steps, so the wheel slows into place. */
+    private static final long STEP_SLOWDOWN_MS = 40;
+    private static final int SLOWING_STEPS = 3;
+    /** After the last roll, the frame that leaves no flip in the launcher's copy. */
+    private static final long SETTLE_DELAY_MS = 200;
+    /** The weight of the slots' face (rn_widget_rolling.xml: sans-serif, bold). */
+    private static final int SLOT_WEIGHT = 700;
+
+    // Guarded by RollingText.class: frames are sent from the module's thread
+    // (a draw) and the main thread (a step).
+    private static final Map<Integer, WidgetState> STATES = new HashMap<>();
+    private static Handler handler;
+
+    private RollingText() {
+    }
+
+    /** A rolling text as laid out in the widget: its characters' places, size and colours. */
+    static final class Group {
+        @Nullable
+        final String key;
+        final String text;
+        final int[] slotLeft;
+        final int[] slotTop;
+        final float textSizePx;
+        final int lightColor;
+        int darkColor;
+
+        Group(@Nullable String key, String text, int[] slotLeft, int[] slotTop, float textSizePx, int color) {
+            this.key = key;
+            this.text = text;
+            this.slotLeft = slotLeft;
+            this.slotTop = slotTop;
+            this.textSizePx = textSizePx;
+            this.lightColor = color;
+            this.darkColor = color;
+        }
+    }
+
+    /** The rolling texts of one draw, by group. */
+    static final class Capture {
+        final Group[] groups = new Group[RollingIds.GROUPS];
+    }
+
+    /** What one group shows, where it is going and which child each slot shows. */
+    private static final class GroupState {
+        Group layout;
+        @Nullable
+        String key;
+        String target;
+        String shown;
+        boolean rise = true;
+        final ArrayDeque<String> steps = new ArrayDeque<>();
+        final int[][] visible = new int[2][RollingIds.SLOTS];
+    }
+
+    private static final class WidgetState {
+        final int widgetId;
+        RemoteViews base;
+        final GroupState[] groups = new GroupState[RollingIds.GROUPS];
+        boolean ticking;
+        int generation;
+
+        WidgetState(int widgetId) {
+            this.widgetId = widgetId;
+        }
+    }
+
+    /**
+     * The light tree's rolling texts, taken out of its bitmap. Call after the
+     * tree is laid out and before it is drawn.
+     */
+    static Capture captureLight(WidgetWithViews widget) {
+        Capture capture = new Capture();
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.S) {
+            return capture;
+        }
+        View root = widget.getRootView();
+        if (!(root instanceof ViewGroup)) {
+            return capture;
+        }
+        for (RollingTextView rolling : widget.getRollingViews()) {
+            int group = rolling.getGroup();
+            if (group < 0 || group >= RollingIds.GROUPS || capture.groups[group] != null) {
+                continue;
+            }
+            Group measured;
+            try {
+                measured = measure((ViewGroup) root, rolling.getKey(), rolling.getView());
+            } catch (RuntimeException e) {
+                // Whatever a device makes of the measuring, the rate is drawn: in the bitmap.
+                Log.w(TAG, "Could not measure a rolling text; it stays in the bitmap", e);
+                measured = null;
+            }
+            if (measured == null) {
+                continue;
+            }
+            capture.groups[group] = measured;
+            rolling.getView().setTextColor(Color.TRANSPARENT);
+        }
+        return capture;
+    }
+
+    /** The dark tree's colours for the groups the light tree gave, and their text out of its bitmap. */
+    static void captureDark(Capture capture, WidgetWithViews widget) {
+        for (RollingTextView rolling : widget.getRollingViews()) {
+            int group = rolling.getGroup();
+            if (group < 0 || group >= RollingIds.GROUPS || capture.groups[group] == null) {
+                continue;
+            }
+            capture.groups[group].darkColor = rolling.getView().getCurrentTextColor();
+            rolling.getView().setTextColor(Color.TRANSPARENT);
+        }
+    }
+
+    /** The layout for a widget's frames: the one with the slots only when something rolls. */
+    static int layoutFor(Capture capture) {
+        return isEmpty(capture) ? R.layout.rn_widget : R.layout.rn_widget_rolling_host;
+    }
+
+    /**
+     * Where each character of a one-line text sits in the widget, or null when
+     * the slots could not show it as drawn: wrapped, cut short or clipped, too
+     * long, or not in the slots' face.
+     */
+    @Nullable
+    @RequiresApi(Build.VERSION_CODES.S)
+    private static Group measure(ViewGroup root, @Nullable String key, TextView view) {
+        Layout layout = view.getLayout();
+        CharSequence chars = view.getText();
+        if (layout == null || chars == null) {
+            return null;
+        }
+        String text = chars.toString();
+        if (text.isEmpty() || text.length() > RollingIds.SLOTS
+            || layout.getLineCount() != 1 || layout.getEllipsisCount(0) > 0) {
+            return null;
+        }
+        for (int i = 0; i < text.length(); i++) {
+            if (Character.isSurrogate(text.charAt(i))) {
+                return null;
+            }
+        }
+        Typeface typeface = view.getTypeface();
+        if (typeface == null || typeface.getWeight() != SLOT_WEIGHT || typeface.isItalic()
+            || view.getShadowRadius() > 0) {
+            return null;
+        }
+
+        Rect bounds = new Rect();
+        view.getDrawingRect(bounds);
+        root.offsetDescendantRectToMyCoords(view, bounds);
+        float left = bounds.left + view.getTotalPaddingLeft();
+        int top = bounds.top + view.getTotalPaddingTop();
+
+        // The bitmap clips the text to every box around it; the slots, laid over
+        // the whole widget, would not. A text cut off there stays there.
+        Rect line = new Rect(
+            (int) Math.ceil(left + layout.getLineLeft(0)),
+            top + layout.getLineTop(0),
+            (int) Math.floor(left + layout.getLineRight(0)),
+            top + layout.getLineBottom(0));
+        if (!insideEveryBox(root, view, line)) {
+            return null;
+        }
+
+        // Each slot is a line of its own, so a character from a taller fallback
+        // font (֏) gives its slot a lower baseline than a digit's: every slot is
+        // placed by its baseline, all on the drawn line's.
+        float baseline = top + layout.getLineBaseline(0);
+        TextView probe = slotProbe(view.getContext(), view.getTextSize());
+        int[] slotLeft = new int[text.length()];
+        int[] slotTop = new int[text.length()];
+        for (int i = 0; i < text.length(); i++) {
+            slotLeft[i] = Math.round(left + layout.getPrimaryHorizontal(i));
+            probe.setText(String.valueOf(text.charAt(i)));
+            probe.measure(View.MeasureSpec.UNSPECIFIED, View.MeasureSpec.UNSPECIFIED);
+            slotTop[i] = Math.round(baseline - probe.getBaseline());
+        }
+        return new Group(key, text, slotLeft, slotTop, view.getTextSize(), view.getCurrentTextColor());
+    }
+
+    // A TextView set up as a slot's (scripts/rollingWidgetResources.js: textView).
+    private static TextView slotProbe(Context context, float textSizePx) {
+        TextView probe = new TextView(context);
+        // Measured as a slot is laid out (wrap_content); a TextView with no
+        // layout params cannot be measured at all.
+        probe.setLayoutParams(new ViewGroup.LayoutParams(
+            ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        probe.setTypeface(Typeface.create("sans-serif", Typeface.BOLD));
+        probe.setIncludeFontPadding(true);
+        probe.setLetterSpacing(0f);
+        probe.setAllCaps(false);
+        probe.setMaxLines(1);
+        probe.setTextSize(TypedValue.COMPLEX_UNIT_PX, textSizePx);
+        return probe;
+    }
+
+    private static boolean insideEveryBox(ViewGroup root, View view, Rect line) {
+        Rect box = new Rect();
+        for (ViewParent parent = view.getParent(); parent instanceof View; parent = parent.getParent()) {
+            View ancestor = (View) parent;
+            ancestor.getDrawingRect(box);
+            if (ancestor != root) {
+                root.offsetDescendantRectToMyCoords(ancestor, box);
+            }
+            if (!box.contains(line)) {
+                return false;
+            }
+            if (ancestor == root) {
+                break;
+            }
+        }
+        return true;
+    }
+
+    /**
+     * Sends the library's frame for a widget with its rolling texts laid over
+     * it, and starts the steps to any text that changed.
+     */
+    static void update(Context context, int widgetId, RemoteViews base, Capture capture) {
+        Context appContext = context.getApplicationContext();
+        AppWidgetManager manager = AppWidgetManager.getInstance(appContext);
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.S) {
+            // Nothing was taken out of the bitmap; the slots stay hidden, as inflated.
+            manager.updateAppWidget(widgetId, base);
+            return;
+        }
+        synchronized (RollingText.class) {
+            SharedPreferences prefs = prefs(appContext);
+            if (isEmpty(capture)) {
+                // Nothing rolls: the library's own layout and frame. Any steps
+                // still due stop with the state; the saved texts stay, to roll
+                // from when a rate is back.
+                STATES.remove(widgetId);
+                if (prefs.getBoolean(hostKey(widgetId), false)) {
+                    prefs.edit().putBoolean(hostKey(widgetId), false).apply();
+                }
+                manager.updateAppWidget(widgetId, base);
+                return;
+            }
+            WidgetState state = STATES.get(widgetId);
+            if (state == null) {
+                state = new WidgetState(widgetId);
+                STATES.put(widgetId, state);
+            }
+            state.base = base;
+
+            SharedPreferences.Editor editor = prefs.edit();
+            // A launcher meeting the slots' layout anew inflates it: every slot
+            // shows its first child, whatever was saved.
+            boolean freshSlots = !prefs.getBoolean(hostKey(widgetId), false);
+            editor.putBoolean(hostKey(widgetId), true);
+            boolean seen = isScreenOn(appContext);
+            boolean stepping = false;
+            for (int g = 0; g < RollingIds.GROUPS; g++) {
+                Group layout = capture.groups[g];
+                if (layout == null) {
+                    // Drawn into the bitmap, or not drawn at all; its last text stays
+                    // saved, so it rolls from there when it is back.
+                    state.groups[g] = null;
+                    continue;
+                }
+                GroupState group = state.groups[g] != null ? state.groups[g] : load(prefs, widgetId, g);
+                if (freshSlots) {
+                    for (int[] visible : group.visible) {
+                        Arrays.fill(visible, 0);
+                    }
+                }
+                group.layout = layout;
+                if (!Objects.equals(layout.key, group.key)) {
+                    // Another pair or amount in this place: a new figure, not a move.
+                    group.key = layout.key;
+                    group.target = layout.text;
+                    group.shown = layout.text;
+                    group.steps.clear();
+                    editor.putString(keyKey(widgetId, g), layout.key);
+                    editor.putString(targetKey(widgetId, g), layout.text);
+                } else if (!layout.text.equals(group.target)) {
+                    String from = group.shown != null ? group.shown : group.target;
+                    group.steps.clear();
+                    if (seen && from != null && sameShape(from, layout.text)) {
+                        group.rise = compareDigits(layout.text, from) > 0;
+                        group.steps.addAll(steps(from, layout.text));
+                        group.shown = from;
+                    } else {
+                        group.shown = layout.text;
+                    }
+                    group.target = layout.text;
+                    editor.putString(targetKey(widgetId, g), layout.text);
+                } else if (group.shown == null || group.shown.length() != layout.text.length()) {
+                    group.shown = layout.text;
+                    group.steps.clear();
+                }
+                state.groups[g] = group;
+                stepping |= !group.steps.isEmpty();
+            }
+            editor.apply();
+
+            send(appContext, state, false);
+            if (stepping && !state.ticking) {
+                schedule(appContext, state, FIRST_STEP_DELAY_MS);
+            }
+        }
+    }
+
+    private static boolean isEmpty(Capture capture) {
+        for (Group group : capture.groups) {
+            if (group != null) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static boolean isScreenOn(Context context) {
+        PowerManager power = context.getSystemService(PowerManager.class);
+        return power == null || power.isInteractive();
+    }
+
+    /** Forgets a removed widget. */
+    static void forget(Context context, int widgetId) {
+        synchronized (RollingText.class) {
+            STATES.remove(widgetId);
+            SharedPreferences.Editor editor = prefs(context.getApplicationContext()).edit();
+            editor.remove(hostKey(widgetId));
+            for (int g = 0; g < RollingIds.GROUPS; g++) {
+                editor.remove(keyKey(widgetId, g));
+                editor.remove(targetKey(widgetId, g));
+                editor.remove(visibleKey(widgetId, g, RollingIds.RISE));
+                editor.remove(visibleKey(widgetId, g, RollingIds.FALL));
+            }
+            editor.apply();
+        }
+    }
+
+    @RequiresApi(Build.VERSION_CODES.S)
+    private static void schedule(Context context, WidgetState state, long delayMs) {
+        state.ticking = true;
+        final int generation = ++state.generation;
+        final int widgetId = state.widgetId;
+        handler().postDelayed(() -> step(context, widgetId, generation), delayMs);
+    }
+
+    // Steps run on the main thread. Made on first use, so loading the class
+    // touches nothing of Android's.
+    private static Handler handler() {
+        if (handler == null) {
+            handler = new Handler(Looper.getMainLooper());
+        }
+        return handler;
+    }
+
+    @RequiresApi(Build.VERSION_CODES.S)
+    private static void step(Context context, int widgetId, int generation) {
+        synchronized (RollingText.class) {
+            WidgetState state = STATES.get(widgetId);
+            if (state == null || state.generation != generation) {
+                return;
+            }
+            if (remainingSteps(state) == 0) {
+                state.ticking = false;
+                return;
+            }
+            send(context, state, true);
+            int remaining = remainingSteps(state);
+            if (remaining > 0) {
+                long slowing = Math.max(0, SLOWING_STEPS - remaining + 1) * STEP_SLOWDOWN_MS;
+                schedule(context, state, STEP_INTERVAL_MS + slowing);
+                return;
+            }
+            state.ticking = false;
+            saveVisible(context, state);
+            final int settled = ++state.generation;
+            handler().postDelayed(() -> settle(context, widgetId, settled), SETTLE_DELAY_MS);
+        }
+    }
+
+    @RequiresApi(Build.VERSION_CODES.S)
+    private static void settle(Context context, int widgetId, int generation) {
+        synchronized (RollingText.class) {
+            WidgetState state = STATES.get(widgetId);
+            if (state == null || state.generation != generation || state.ticking) {
+                return;
+            }
+            send(context, state, false);
+        }
+    }
+
+    private static int remainingSteps(WidgetState state) {
+        int remaining = 0;
+        for (GroupState group : state.groups) {
+            if (group != null) {
+                remaining = Math.max(remaining, group.steps.size());
+            }
+        }
+        return remaining;
+    }
+
+    /**
+     * One frame: the library's views with every slot set, and on a step the
+     * slots whose character changes flipped to it.
+     */
+    @RequiresApi(Build.VERSION_CODES.S)
+    private static void send(Context context, WidgetState state, boolean step) {
+        // A copy: the library's frame is the base of every step until its next draw.
+        RemoteViews views = new RemoteViews(state.base);
+        for (int g = 0; g < RollingIds.GROUPS; g++) {
+            GroupState group = state.groups[g];
+            if (group == null) {
+                // Every frame says so: a reapplied layout keeps what the last one showed.
+                views.setViewVisibility(RollingIds.CONTAINERS[g][RollingIds.RISE], View.GONE);
+                views.setViewVisibility(RollingIds.CONTAINERS[g][RollingIds.FALL], View.GONE);
+                continue;
+            }
+            String next = step && !group.steps.isEmpty() ? group.steps.poll() : group.shown;
+            setGroup(views, g, group, next);
+            group.shown = next;
+        }
+        AppWidgetManager.getInstance(context).updateAppWidget(state.widgetId, views);
+    }
+
+    // Which child each slot shows, for a roll after the process is gone.
+    private static void saveVisible(Context context, WidgetState state) {
+        SharedPreferences.Editor editor = prefs(context).edit();
+        for (int g = 0; g < RollingIds.GROUPS; g++) {
+            GroupState group = state.groups[g];
+            if (group == null) {
+                continue;
+            }
+            editor.putString(visibleKey(state.widgetId, g, RollingIds.RISE), encode(group.visible[RollingIds.RISE]));
+            editor.putString(visibleKey(state.widgetId, g, RollingIds.FALL), encode(group.visible[RollingIds.FALL]));
+        }
+        editor.apply();
+    }
+
+    @RequiresApi(Build.VERSION_CODES.S)
+    private static void setGroup(RemoteViews views, int g, GroupState group, String next) {
+        int dir = group.rise ? RollingIds.RISE : RollingIds.FALL;
+        views.setViewVisibility(RollingIds.CONTAINERS[g][dir], View.VISIBLE);
+        views.setViewVisibility(RollingIds.CONTAINERS[g][1 - dir], View.GONE);
+
+        Group layout = group.layout;
+        String shown = group.shown;
+        for (int i = 0; i < RollingIds.SLOTS; i++) {
+            int flipper = RollingIds.FLIPPERS[g][dir][i];
+            if (i >= next.length() || i >= layout.slotLeft.length) {
+                views.setViewVisibility(flipper, View.GONE);
+                continue;
+            }
+            int[] children = {RollingIds.CHILD_A[g][dir][i], RollingIds.CHILD_B[g][dir][i]};
+            views.setViewVisibility(flipper, View.VISIBLE);
+            views.setViewLayoutMargin(flipper, RemoteViews.MARGIN_LEFT, layout.slotLeft[i], TypedValue.COMPLEX_UNIT_PX);
+            views.setViewLayoutMargin(flipper, RemoteViews.MARGIN_TOP, layout.slotTop[i], TypedValue.COMPLEX_UNIT_PX);
+            for (int child : children) {
+                views.setTextViewTextSize(child, TypedValue.COMPLEX_UNIT_PX, layout.textSizePx);
+                views.setColorInt(child, "setTextColor", layout.lightColor, layout.darkColor);
+            }
+
+            String now = String.valueOf(i < shown.length() ? shown.charAt(i) : next.charAt(i));
+            String then = String.valueOf(next.charAt(i));
+            int showing = group.visible[dir][i];
+            if (!then.equals(now)) {
+                int hidden = 1 - showing;
+                views.setTextViewText(children[showing], now);
+                views.setTextViewText(children[hidden], then);
+                views.setDisplayedChild(flipper, hidden);
+                group.visible[dir][i] = hidden;
+            } else {
+                views.setTextViewText(children[0], now);
+                views.setTextViewText(children[1], now);
+            }
+        }
+    }
+
+    // Digits roll; every other character must match for two texts to share a shape.
+    private static boolean isRollingDigit(char c) {
+        return c >= '0' && c <= '9';
+    }
+
+    static boolean sameShape(String a, String b) {
+        if (a.length() != b.length()) {
+            return false;
+        }
+        boolean digits = false;
+        for (int i = 0; i < a.length(); i++) {
+            char x = a.charAt(i);
+            char y = b.charAt(i);
+            if (isRollingDigit(x) && isRollingDigit(y)) {
+                digits = true;
+            } else if (x != y) {
+                return false;
+            }
+        }
+        return digits;
+    }
+
+    private static BigInteger digitsOf(String text) {
+        StringBuilder digits = new StringBuilder();
+        for (int i = 0; i < text.length(); i++) {
+            if (isRollingDigit(text.charAt(i))) {
+                digits.append(text.charAt(i));
+            }
+        }
+        return new BigInteger(digits.toString());
+    }
+
+    static int compareDigits(String a, String b) {
+        return digitsOf(a).compareTo(digitsOf(b));
+    }
+
+    /**
+     * The texts between two of the same shape, the last being `to`: one per
+     * unit of the last digit, or MAX_STEPS evenly spread over a bigger move.
+     */
+    static List<String> steps(String from, String to) {
+        BigInteger start = digitsOf(from);
+        BigInteger end = digitsOf(to);
+        BigInteger move = end.subtract(start);
+        int count = move.abs().min(BigInteger.valueOf(MAX_STEPS)).intValue();
+        List<String> texts = new ArrayList<>();
+        for (int k = 1; k <= count; k++) {
+            BigInteger value = k == count
+                ? end
+                : start.add(move.multiply(BigInteger.valueOf(k)).divide(BigInteger.valueOf(count)));
+            texts.add(withDigits(to, value));
+        }
+        return texts;
+    }
+
+    // `value` written into the digit places of `template`, zero-padded.
+    private static String withDigits(String template, BigInteger value) {
+        int places = 0;
+        for (int i = 0; i < template.length(); i++) {
+            if (isRollingDigit(template.charAt(i))) {
+                places++;
+            }
+        }
+        StringBuilder digits = new StringBuilder(value.abs().toString());
+        while (digits.length() < places) {
+            digits.insert(0, '0');
+        }
+        StringBuilder text = new StringBuilder(template);
+        int d = digits.length() - places;
+        for (int i = 0; i < text.length(); i++) {
+            if (isRollingDigit(text.charAt(i))) {
+                text.setCharAt(i, digits.charAt(d++));
+            }
+        }
+        return text.toString();
+    }
+
+    private static GroupState load(SharedPreferences prefs, int widgetId, int g) {
+        GroupState group = new GroupState();
+        group.key = prefs.getString(keyKey(widgetId, g), null);
+        group.target = prefs.getString(targetKey(widgetId, g), null);
+        group.shown = group.target;
+        decode(prefs.getString(visibleKey(widgetId, g, RollingIds.RISE), null), group.visible[RollingIds.RISE]);
+        decode(prefs.getString(visibleKey(widgetId, g, RollingIds.FALL), null), group.visible[RollingIds.FALL]);
+        return group;
+    }
+
+    private static String encode(int[] visible) {
+        StringBuilder bits = new StringBuilder(visible.length);
+        for (int child : visible) {
+            bits.append(child == 1 ? '1' : '0');
+        }
+        return bits.toString();
+    }
+
+    private static void decode(@Nullable String bits, int[] visible) {
+        if (bits == null) {
+            return;
+        }
+        for (int i = 0; i < visible.length && i < bits.length(); i++) {
+            visible[i] = bits.charAt(i) == '1' ? 1 : 0;
+        }
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private static String hostKey(int widgetId) {
+        return "host:" + widgetId;
+    }
+
+    private static String keyKey(int widgetId, int g) {
+        return "key:" + widgetId + ":" + g;
+    }
+
+    private static String targetKey(int widgetId, int g) {
+        return "text:" + widgetId + ":" + g;
+    }
+
+    private static String visibleKey(int widgetId, int g, int dir) {
+        return "shows:" + widgetId + ":" + g + ":" + dir;
+    }
+}
